{
  "name": "pinkwave",
  "productName": "Pinkwave",
  "version": "0.1.0",
  "description": "A Spotify-inspired desktop music player powered by YouTube",
  "author": "Pinkwave",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --no-warnings src/main/services/youtube/format.test.ts && node --no-warnings src/renderer/src/utils/queue.test.ts && node --no-warnings src/main/services/database/library.test.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
